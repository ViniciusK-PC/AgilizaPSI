//   output = "./erd.svg"
// }

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
 
enum UserRole {
  USER
  ADMIN
  PSICOLOGO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  ONLINE
  PRESENCIAL
}

enum PsychiatricFollowUp {
  NAO
  SIM
  JA_FEZ
}
 
model User {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String        @unique
  phone                 String
  emailVerified         DateTime?
  image                 String?
  role                  UserRole      @default(USER)
  password              String
  plainPassword         String?       // Senha em texto plano (apenas para visualização no admin)
  accounts              Account[]
  sessions              Session[]
  isVerfied             Boolean       @default(false)
  token                 Int
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  
  // Professional data (for PSICOLOGO role)
  crp                   String?       // Registro no CRP
  specialization        String?       // Especialização
  bio                   String?       // Biografia profissional
  experience           Int?          // Anos de experiência
  languages             String[]      // Idiomas falados
  specialties           String[]     // Especialidades
  accessToken           String?       // Token único para acesso ao dashboard (pode ser null para usuários regulares)
  
  // Appointments relations
  appointmentsAsPsychologist Appointment[]         @relation("PsychologistAppointments")
  appointmentsAsPatient      Appointment[]         @relation("PatientAppointments")
  
  // Medical Records relations
  medicalRecordsAsPatient    MedicalRecord[]       @relation("PatientRecords")
  medicalRecordsAsPsychologist MedicalRecord[]     @relation("PsychologistRecords")
  
  // Other relations
  reminders                  Reminder[]            @relation("UserReminders")
  psychologistSettings       PsychologistSettings? @relation("PsychologistSettings")
  bankAccount                BankAccount?          @relation("UserBankAccount")
  clinic                     Clinic?               @relation("ClinicProfessionals", fields: [clinicId], references: [id], onDelete: SetNull)
  clinicId                   String?               @db.ObjectId
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  psychologistId  String            @db.ObjectId
  patientId       String?           @db.ObjectId
  date            DateTime
  startTime       String            // formato HH:mm
  endTime         String            // formato HH:mm
  duration        Int               // em minutos
  status          AppointmentStatus @default(PENDING)
  type            AppointmentType   @default(ONLINE)
  notes           String?
  price           Float?
  meetingLink     String?           // Link da sala virtual
  reminderSent    Boolean           @default(false)
  
  psychologist    User              @relation("PsychologistAppointments", fields: [psychologistId], references: [id], onDelete: Cascade)
  patient         User?             @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: SetNull)
  medicalRecord   MedicalRecord?    @relation("AppointmentRecord")
  payment         Payment?          @relation("AppointmentPayment")
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@index([psychologistId])
  @@index([patientId])
  @@index([date])
  @@index([status])
}

// Prontuário Eletrônico
model MedicalRecord {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId         String              @unique @db.ObjectId
  patientId             String              @db.ObjectId
  psychologistId        String              @db.ObjectId
  
  chiefComplaint        String              // Queixa principal
  diagnosis             String?             // Diagnóstico
  treatment             String?             // Tratamento/Intervenção
  observations          String?             // Observações da sessão
  evolution             String?             // Evolução do paciente
  prescription          String?             // Prescrição/Recomendações
  psychiatricFollowUp   PsychiatricFollowUp?

  appointment           Appointment         @relation("AppointmentRecord", fields: [appointmentId], references: [id], onDelete: Cascade)
  patient               User                @relation("PatientRecords", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist          User                @relation("PsychologistRecords", fields: [psychologistId], references: [id], onDelete: Cascade)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([patientId])
  @@index([psychologistId])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String        @unique @db.ObjectId
  amount          Float
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod?
  transactionId   String?
  paidAt          DateTime?
  
  appointment     Appointment   @relation("AppointmentPayment", fields: [appointmentId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([status])
  @@index([paidAt])
}

// Lembretes e Notificações
enum ReminderType {
  EMAIL
  SMS
  WHATSAPP
}

model Reminder {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId   String       @db.ObjectId
  userId          String       @db.ObjectId
  type            ReminderType
  scheduledFor    DateTime
  sent            Boolean      @default(false)
  sentAt          DateTime?
  message         String
  
  user            User         @relation("UserReminders", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([appointmentId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([sent])
}

// Configurações de Personalização
model PsychologistSettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  psychologistId        String   @unique @db.ObjectId
  
  workingHoursStart     String   @default("08:00")
  workingHoursEnd       String   @default("18:00")
  defaultSessionDuration Int     @default(60)
  defaultPrice          Float    @default(150.0)
  acceptOnlineAppointments Boolean @default(true)
  acceptInPersonAppointments Boolean @default(true)
  autoConfirmAppointments Boolean @default(false)
  
  bio                   String?
  specialties           String[]
  languages             String[]
  
  psychologist          User     @relation("PsychologistSettings", fields: [psychologistId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Dados Bancários do Profissional
model BankAccount {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  
  // Dados bancários
  bankName        String?  // Nome do banco
  agency          String?  // Agência
  account         String?  // Conta corrente/poupança
  accountType     String?  // Tipo de conta (CORRENTE, POUPANCA)
  
  // PIX
  pixKey          String?  // Chave PIX
  pixKeyType      String?  // Tipo: CPF, EMAIL, TELEFONE, ALEATORIA
  
  // Dados do titular
  accountHolderName String? // Nome do titular
  cpf             String?  // CPF do titular
  
  user            User     @relation("UserBankAccount", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Modelo de Clínica (CRUD)
model Clinic {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Informações da Clínica
  name                  String   // Nome da clínica
  email                 String?
  phone                 String?
  address               String?
  cnpj                  String?  @unique
  description           String?  // Descrição da clínica
  accessToken           String?  @unique // Token único para link de acesso/cadastro
  
  // Horários de Funcionamento
  workingDays           String[] // ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]
  workingHoursStart     String   @default("08:00")
  workingHoursEnd       String   @default("18:00")
  timezone              String   @default("America/Sao_Paulo")
  
  // Configurações de Agendamento
  minAdvanceBookingDays Int      @default(30)
  maxAdvanceBookingDays Int      @default(90)
  appointmentDuration   Int      @default(60) // Duração padrão em minutos
  cancellationDeadline  Int      @default(24) // Horas antes do agendamento
  
  // Configurações de Notificações
  enableEmailReminders  Boolean  @default(true)
  enableSMSReminders    Boolean  @default(false)
  reminderTimeBefore    Int      @default(24)
  
  // Configurações de Pagamento
  defaultPaymentMethod  String?  // PIX, CREDIT_CARD, etc.
  enableOnlinePayment   Boolean  @default(true)
  
  // Status
  isActive              Boolean  @default(true)
  
  // Relação com configurações
  settings              ClinicSettings?
  
  // Relação com profissionais
  professionals         User[]   @relation("ClinicProfessionals")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([name])
  @@index([isActive])
}

// Configurações Gerais da Clínica/Sistema (mantido para compatibilidade)
model ClinicSettings {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  clinicId              String?  @unique @db.ObjectId
  
  // Informações da Clínica (legado)
  clinicName            String   @default("AgilizaPSI")
  clinicEmail           String?
  clinicPhone           String?
  clinicAddress         String?
  clinicCNPJ            String?
  
  // Horários de Funcionamento
  workingDays           String[] // ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]
  workingHoursStart     String   @default("08:00")
  workingHoursEnd       String   @default("18:00")
  timezone              String   @default("America/Sao_Paulo")
  
  // Configurações de Agendamento
  minAdvanceBookingDays Int      @default(30) // Dias mínimos de antecedência
  maxAdvanceBookingDays Int      @default(90) // Dias máximos de antecedência
  appointmentDuration   Int      @default(60) // Duração padrão em minutos
  cancellationDeadline  Int      @default(24) // Horas antes do agendamento para cancelar
  
  // Configurações de Notificações
  enableEmailReminders  Boolean  @default(true)
  enableSMSReminders    Boolean  @default(false)
  reminderTimeBefore    Int      @default(24) // Horas antes do agendamento
  
  // Configurações de Pagamento
  defaultPaymentMethod  String?  // PIX, CREDIT_CARD, etc.
  enableOnlinePayment   Boolean  @default(true)
  
  // Configurações Gerais
  maintenanceMode       Boolean  @default(false)
  allowPublicRegistration Boolean @default(true)
  requireEmailVerification Boolean @default(true)
  
  // Políticas e Termos
  termsOfService        String?
  privacyPolicy         String?
  cancellationPolicy    String?
  
  clinic                Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
 
 
