@startuml DiagramaCasosUso_AgilizaPSI

skinparam usecase {
    BackgroundColor #4A90E2
    BorderColor #2E5C8A
    FontColor white
    FontSize 12
}

skinparam actor {
    BackgroundColor #E8E8E8
    BorderColor #333333
}

skinparam rectangle {
    BorderColor #333333
    BorderThickness 2
}

title Figura 1 - Diagrama de Casos de Uso da AgilizaPSI

rectangle "AgilizaPSI" {
    
    ' Casos de uso do Psicólogo
    usecase UC01 as "Autorizar\nSecretário(a)"
    usecase UC02 as "CRUD\npacientes"
    usecase UC03 as "Consultar\nagenda"
    usecase UC04 as "Agendar, modificar\ne excluir sessões\ne consultas"
    usecase UC05 as "Anexar e visualizar\nDocumentos/Laudos"
    usecase UC06 as "Acessar e editar\nProntuário Eletrônico"
    usecase UC07 as "Gerenciar\nPagamentos"
    usecase UC08 as "Chat com\nPacientes"
    usecase UC09 as "Visualizar\nRelatórios"
    usecase UC10 as "Gerenciar\nDisponibilidade"
    
    ' Casos de uso do Secretário
    usecase UC11 as "Consultar\nagenda"
    usecase UC12 as "CRUD\npacientes"
    usecase UC13 as "Agendar, visualizar\ne modificar sessões\ne consultas"
    usecase UC14 as "Anexar e visualizar\nDocumentos/Laudos"
    
    ' Casos de uso do Administrador
    usecase UC15 as "Gerenciar\nClínicas"
    usecase UC16 as "Gerenciar\nProfissionais"
    usecase UC17 as "Gerenciar\nUsuários"
    usecase UC18 as "Visualizar\nEstatísticas Gerais"
    usecase UC19 as "Configurar\nSistema"
    
    ' Casos de uso do Paciente
    usecase UC20 as "Agendar\nConsulta"
    usecase UC21 as "Visualizar\nLembretes"
    usecase UC22 as "Acessar Sala\nVirtual"
    usecase UC23 as "Chat com\nPsicólogo"
    usecase UC24 as "Visualizar\nHistórico"
}

' Atores
actor "*Psicólogo" as Psicologo
actor "*Secretário(a)" as Secretario
actor "*Administrador" as Admin
actor "*Paciente" as Paciente

' Relacionamentos do Psicólogo
Psicologo --> UC01
Psicologo --> UC02
Psicologo --> UC03
Psicologo --> UC04
Psicologo --> UC05
Psicologo --> UC06
Psicologo --> UC07
Psicologo --> UC08
Psicologo --> UC09
Psicologo --> UC10

' Relacionamentos do Secretário
Secretario --> UC11
Secretario --> UC12
Secretario --> UC13
Secretario --> UC14

' Relacionamentos do Administrador
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19

' Relacionamentos do Paciente
Paciente --> UC20
Paciente --> UC21
Paciente --> UC22
Paciente --> UC23
Paciente --> UC24

' Relacionamentos entre casos de uso (dependências)
UC02 ..> UC04 : <<include>>
UC02 ..> UC05 : <<include>>
UC02 ..> UC06 : <<include>>
UC04 ..> UC06 : <<include>>
UC05 ..> UC06 : <<include>>
UC04 ..> UC07 : <<include>>
UC13 ..> UC06 : <<include>>
UC12 ..> UC13 : <<include>>

@enduml

